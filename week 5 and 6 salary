/*
 * Employee Salary Management System
 * Weeks 5-6 Integrated Challenge
 *
 * Loops -> Arrays -> Searching -> Sorting -> Problem solving
 */

#include <stdio.h>
#include <stdlib.h>

#define NUM_EMPLOYEES 50

/* ---------- Input helpers ---------- */

void clearInput(void)
{
    int c;
    while ((c = getchar()) != '\n' && c != EOF)
        ;
}

/* Keeps asking until a valid non-negative number is entered. */
float readSalary(const char *prompt)
{
    float value;
    int result;

    while (1)
    {
        printf("%s", prompt);
        result = scanf("%f", &value);

        if (result == EOF)
        {
            printf("\nInput ended. Exiting.\n");
            exit(1);
        }
        if (result == 1 && value >= 0)
        {
            clearInput();
            return value;
        }
        printf("Invalid input. Enter a number that is 0 or more.\n");
        clearInput();
    }
}

int readInt(const char *prompt)
{
    int value;
    int result;

    while (1)
    {
        printf("%s", prompt);
        result = scanf("%d", &value);

        if (result == EOF)
        {
            printf("\nInput ended. Exiting.\n");
            exit(1);
        }
        if (result == 1)
        {
            clearInput();
            return value;
        }
        printf("Invalid input. Enter a whole number.\n");
        clearInput();
    }
}

/* ---------- 1 & 2. Capture and store ---------- */

void captureSalaries(float salaries[], int n)
{
    int i;
    char prompt[50];

    for (i = 0; i < n; i++)
    {
        sprintf(prompt, "Enter salary for employee %d: ", i + 1);
        salaries[i] = readSalary(prompt);
    }
}

/* ---------- 3 & 10. Display ---------- */

void displaySalaries(const float salaries[], int n, const char *title)
{
    int i;

    printf("\n--- %s ---\n", title);
    for (i = 0; i < n; i++)
        printf("%2d: %10.2f\n", i + 1, salaries[i]);
}

/* ---------- 4. Total ---------- */

float calcTotal(const float salaries[], int n)
{
    float total = 0;
    int i;

    for (i = 0; i < n; i++)
        total += salaries[i];
    return total;
}

/* ---------- 5. Average ---------- */

float calcAverage(const float salaries[], int n)
{
    return calcTotal(salaries, n) / n;
}

/* ---------- 6 & 7. Highest and lowest (return the index) ---------- */

int findHighest(const float salaries[], int n)
{
    int i, best = 0;

    for (i = 1; i < n; i++)
        if (salaries[i] > salaries[best])
            best = i;
    return best;
}

int findLowest(const float salaries[], int n)
{
    int i, best = 0;

    for (i = 1; i < n; i++)
        if (salaries[i] < salaries[best])
            best = i;
    return best;
}

/* ---------- 8. Search ---------- */

void searchSalary(const float salaries[], int n)
{
    float target = readSalary("Enter the salary to search for: ");
    int i, found = 0;

    for (i = 0; i < n; i++)
    {
        /* Compare to the nearest cent: exact == on floats can miss values */
        float diff = salaries[i] - target;
        if (diff < 0)
            diff = -diff;

        if (diff < 0.005f)
        {
            printf("Found %.2f for employee %d.\n", salaries[i], i + 1);
            found = 1;
        }
    }
    if (!found)
        printf("Salary %.2f was not found.\n", target);
}

/* ---------- 9. Sort (bubble sort, lowest to highest) ---------- */

void sortSalaries(float salaries[], int n)
{
    int i, j;
    float temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - 1 - i; j++)
        {
            if (salaries[j] > salaries[j + 1])
            {
                temp = salaries[j];
                salaries[j] = salaries[j + 1];
                salaries[j + 1] = temp;
            }
        }
    }
}

/* ---------- Main ---------- */

int main(void)
{
    float salaries[NUM_EMPLOYEES];
    float sorted[NUM_EMPLOYEES];
    int captured = 0;
    int choice, i, idx;

    do
    {
        printf("\n=========================================\n");
        printf("   EMPLOYEE SALARY MANAGEMENT SYSTEM\n");
        printf("=========================================\n");
        printf(" 1. Capture salaries (%d employees)\n", NUM_EMPLOYEES);
        printf(" 2. Display all salaries\n");
        printf(" 3. Total salary expenditure\n");
        printf(" 4. Average salary\n");
        printf(" 5. Highest salary\n");
        printf(" 6. Lowest salary\n");
        printf(" 7. Search for a salary\n");
        printf(" 8. Sort and display salaries (lowest to highest)\n");
        printf(" 0. Exit\n");
        choice = readInt("Choice: ");

        if (choice >= 2 && choice <= 8 && !captured)
        {
            printf("Please capture the salaries first (option 1).\n");
            continue;
        }

        switch (choice)
        {
        case 1:
            captureSalaries(salaries, NUM_EMPLOYEES);
            captured = 1;
            break;
        case 2:
            displaySalaries(salaries, NUM_EMPLOYEES, "All Salaries");
            break;
        case 3:
            printf("Total salary expenditure: %.2f\n",
                   calcTotal(salaries, NUM_EMPLOYEES));
            break;
        case 4:
            printf("Average salary: %.2f\n",
                   calcAverage(salaries, NUM_EMPLOYEES));
            break;
        case 5:
            idx = findHighest(salaries, NUM_EMPLOYEES);
            printf("Highest salary: %.2f (employee %d)\n", salaries[idx], idx + 1);
            break;
        case 6:
            idx = findLowest(salaries, NUM_EMPLOYEES);
            printf("Lowest salary: %.2f (employee %d)\n", salaries[idx], idx + 1);
            break;
        case 7:
            searchSalary(salaries, NUM_EMPLOYEES);
            break;
        case 8:
            /* Sort a copy so the original employee order is kept */
            for (i = 0; i < NUM_EMPLOYEES; i++)
                sorted[i] = salaries[i];
            sortSalaries(sorted, NUM_EMPLOYEES);
            displaySalaries(sorted, NUM_EMPLOYEES, "Sorted Salaries (Lowest to Highest)");
            break;
        case 0:
            printf("Goodbye.\n");
            break;
        default:
            printf("Invalid choice.\n");
        }
    } while (choice != 0);

    return 0;
}
