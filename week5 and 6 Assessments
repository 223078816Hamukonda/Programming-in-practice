/*
 * Suggested Assessment Questions - Model Answers (Questions 1 to 7)
 *
 * Each question is a separate function. Run the program and pick a
 * question number from the menu. In an exam, each function body can be
 * copied into its own main() as a standalone answer.
 */

#include <stdio.h>
#include <stdlib.h>

void clearInput(void)
{
    int c;
    while ((c = getchar()) != '\n' && c != EOF)
        ;
}

/* Reads a number; returns 1 on success, 0 if the input was not a number. */
int readNumber(const char *prompt, float *value)
{
    int result;

    printf("%s", prompt);
    result = scanf("%f", value);
    if (result == EOF)
    {
        printf("\nInput ended. Exiting.\n");
        exit(1);
    }
    clearInput();                       /* discard the rest of the line */
    return result == 1;
}

/* ---------- Question 1: For loop, numbers 1 to 100 ---------- */

void question1(void)
{
    int i;

    for (i = 1; i <= 100; i++)
        printf("%d\n", i);
}

/* ---------- Question 2: While loop, repeat until salary is positive ---------- */

void question2(void)
{
    float salary = 0;
    int ok;

    while (salary <= 0)
    {
        ok = readNumber("Enter a positive salary: ", &salary);
        if (!ok)
            salary = 0;                 /* not a number: stay in the loop */
        if (salary <= 0)
            printf("Invalid. The salary must be greater than 0.\n");
    }
    printf("Salary accepted: %.2f\n", salary);
}

/* ---------- Question 3: Do while, menu until option 4 ---------- */

void question3(void)
{
    float salaries[100];
    int count = 0;
    int choice, i, found;
    float value;

    do
    {
        printf("\n1. View salaries\n");
        printf("2. Add salary\n");
        printf("3. Search salary\n");
        printf("4. Exit\n");
        printf("Choice: ");
        if (scanf("%d", &choice) != 1)
        {
            clearInput();
            choice = 0;
        }
        else
            clearInput();

        switch (choice)
        {
        case 1:
            if (count == 0)
                printf("No salaries yet.\n");
            for (i = 0; i < count; i++)
                printf("%d: %.2f\n", i + 1, salaries[i]);
            break;
        case 2:
            if (count == 100)
                printf("The list is full.\n");
            else if (readNumber("Enter salary: ", &value) && value > 0)
                salaries[count++] = value;
            else
                printf("Invalid salary.\n");
            break;
        case 3:
            if (readNumber("Salary to search for: ", &value))
            {
                found = 0;
                for (i = 0; i < count; i++)
                    if (salaries[i] == value)
                    {
                        printf("Found at position %d.\n", i + 1);
                        found = 1;
                    }
                if (!found)
                    printf("Not found.\n");
            }
            break;
        case 4:
            printf("Goodbye.\n");
            break;
        default:
            printf("Invalid choice.\n");
        }
    } while (choice != 4);
}

/* ---------- Question 4: Break and continue ---------- */

void question4(void)
{
    float salary, total = 0;
    int processed = 0;

    while (processed < 20)
    {
        if (!readNumber("Enter salary (0 to stop): ", &salary))
        {
            printf("Not a number.\n");
            continue;
        }
        if (salary == 0)
            break;                      /* stop when 0 is entered */
        if (salary < 0)
        {
            printf("Negative salary ignored.\n");
            continue;                   /* skip: not counted */
        }
        total += salary;
        processed++;
    }
    printf("Processed %d salaries. Total = %.2f\n", processed, total);
}

/* ---------- Question 5: Array of 50 salaries ---------- */

void question5(void)
{
    float salaries[50];
    int i;

    for (i = 0; i < 50; i++)
    {
        while (!readNumber("Enter salary: ", &salaries[i]))
            printf("Invalid input.\n");
    }
    printf("Captured %d salaries. First: %.2f  Last: %.2f\n",
           50, salaries[0], salaries[49]);
}

/* ---------- Question 6: Search an array of 20 salaries ---------- */

void question6(void)
{
    float salaries[20];
    float target;
    int i, found = 0;

    for (i = 0; i < 20; i++)
    {
        while (!readNumber("Enter salary: ", &salaries[i]))
            printf("Invalid input.\n");
    }

    while (!readNumber("Enter the salary to search for: ", &target))
        printf("Invalid input.\n");

    for (i = 0; i < 20; i++)
    {
        if (salaries[i] == target)
        {
            printf("Salary %.2f found at position %d.\n", target, i + 1);
            found = 1;
            break;
        }
    }
    if (!found)
        printf("Salary %.2f was not found.\n", target);
}

/* ---------- Question 7: Sort 10 department budgets (ascending) ---------- */

void question7(void)
{
    float budgets[10];
    float temp;
    int i, j;

    for (i = 0; i < 10; i++)
    {
        while (!readNumber("Enter department budget: ", &budgets[i]))
            printf("Invalid input.\n");
    }

    for (i = 0; i < 9; i++)
        for (j = 0; j < 9 - i; j++)
            if (budgets[j] > budgets[j + 1])
            {
                temp = budgets[j];
                budgets[j] = budgets[j + 1];
                budgets[j + 1] = temp;
            }

    printf("\nBudgets (lowest to highest):\n");
    for (i = 0; i < 10; i++)
        printf("%d: %.2f\n", i + 1, budgets[i]);
}

/* ---------- Main: pick a question ---------- */

int main(void)
{
    int q;

    do
    {
        printf("\nAssessment answers - choose a question (1-7, 0 to exit): ");
        if (scanf("%d", &q) != 1)
        {
            if (feof(stdin))
                break;
            clearInput();
            q = -1;
        }
        else
            clearInput();

        switch (q)
        {
        case 1: question1(); break;
        case 2: question2(); break;
        case 3: question3(); break;
        case 4: question4(); break;
        case 5: question5(); break;
        case 6: question6(); break;
        case 7: question7(); break;
        case 0: break;
        default: printf("Choose 0 to 7.\n");
        }
    } while (q != 0);

    return 0;
}
